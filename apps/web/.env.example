# ═══════════════════════════════════════════════════════════════════════════
# apps/web — biến môi trường
# Local: copy file này thành `.env.local` (đã gitignore) rồi điền. Next.js tự nạp `.env.local` (ưu tiên) và `.env`.
# Production: KHÔNG dùng file — đặt trong Vercel → Settings → Environment Variables, đổi xong phải Redeploy.
# Cổng dev: `next dev` mặc định 3000 (Next.js KHÔNG đọc PORT từ file .env).
# ═══════════════════════════════════════════════════════════════════════════

# [BẮT BUỘC] Địa chỉ Express mà Next.js chuyển tiếp /api/* tới (chỉ server dùng, không lộ ra trình duyệt).
# Local: http://127.0.0.1:3001 · Vercel: https://aodai.onrender.com (không có "/" cuối). Đọc lúc build.
API_INTERNAL_URL=http://127.0.0.1:3001

# [BẮT BUỘC] Giữ nguyên "/api" — trình duyệt gọi cùng origin để dùng chung cookie httpOnly.
NEXT_PUBLIC_API_URL=/api

# [BẮT BUỘC] Giống GOOGLE_CLIENT_ID của apps/api (lộ ra trình duyệt — không phải bí mật).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# [BẮT BUỘC] Chỉ PUBLIC key (giống JWT_PUBLIC_KEY của apps/api) — xác minh phiên admin ở server.
# KHÔNG BAO GIỜ đặt private key ở web.
JWT_PUBLIC_KEY=

# [BẮT BUỘC] Khu admin gọi Prisma trực tiếp — thiếu biến này mọi trang admin bị đẩy về đăng nhập.
# Local: giống DATABASE_URL của apps/api.
# Vercel: Neon chuỗi POOLED (`-pooler`) + `&pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_aodai?schema=public"
