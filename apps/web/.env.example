PORT=3000

# Biến có tiền tố NEXT_PUBLIC_ mới được truyền xuống Client-side
# Trình duyệt gọi API qua đường dẫn tương đối /api (Next.js rewrites chuyển tiếp sang Express -> cùng origin).
# Chỉ đổi khi deploy web và API khác domain (lúc đó cookie httpOnly sẽ không dùng chung được).
NEXT_PUBLIC_API_URL="/api"

# Địa chỉ nội bộ của Express mà server Next.js chuyển tiếp tới (không lộ ra trình duyệt)
API_INTERNAL_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# RSA Public Key (chỉ dùng phía server: proxy.ts & Server Actions admin) để xác minh chữ ký admin_token.
# Phải trùng với JWT_PUBLIC_KEY trong apps/api/.env. Đây là public key — KHÔNG đặt private key vào đây.
JWT_PUBLIC_KEY="your_base64_public_key"
