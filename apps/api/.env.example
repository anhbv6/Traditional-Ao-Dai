# ─── Máy chủ ────────────────────────────────────────────────────────────────
PORT=3001                                   # [TÙY CHỌN] Mặc định 3001. Render tự cấp PORT — không đặt trên Render.
NODE_ENV=development                        # [TÙY CHỌN] development | production | test. production: cookie Secure (cần HTTPS), tắt Swagger.
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=1                               # Rate-limit theo IP phụ thuộc giá trị này. Local: 1 · Render: 2.


# ─── Database ───────────────────────────────────────────────────────────────
# Neon: dùng chuỗi DIRECT (không có `-pooler`) cho API và cho lệnh migration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_aodai?schema=public"        # [BẮT BUỘC] PostgreSQL. Local: postgresql://<user>:<pass>@localhost:5432/<db>?schema=public


# ─── JWT (RS256) ────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=15m


# ─── Redis ──────────────────────────────────────────────────────────────────
# Có URL thì bỏ qua HOST/PORT/PASSWORD
REDIS_URL=

# Không có URL thì dùng HOST/PORT/PASSWORD
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OTP_TTL_SECONDS=300


# ─── Google OAuth ───────────────────────────────────────────────────────────
# [BẮT BUỘC] Google Cloud → APIs & Services → Credentials → OAuth Client ID (Web application).
# Thêm http://localhost:3000 vào "Authorized JavaScript origins". Giá trị giống NEXT_PUBLIC_GOOGLE_CLIENT_ID của web.
GOOGLE_CLIENT_ID=


# ─── Cloudinary (upload ảnh) ────────────────────────────────────────────────
# [BẮT BUỘC] Cloudinary Console → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ─── Tài khoản nhận chuyển khoản (VietQR) ───────────────────────────────────
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=


# ─── Email ──────────────────────────────────────────────────────────────────
# [TÙY CHỌN] Thứ tự ưu tiên: BREVO_API_KEY → SMTP_* → không có gì thì IN MÃ RA CONSOLE (tiện cho dev).
# Brevo: Settings → SMTP & API → tab "API keys" (dạng xkeysib-..., KHÔNG phải SMTP key). Render bắt buộc dùng Brevo (chặn cổng SMTP).
BREVO_API_KEY=
# SMTP (vd. Gmail: smtp.gmail.com / 587 / app password). Để trống cả nhóm nếu không dùng.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Email + tên người gửi (Brevo: email phải là sender đã xác minh).
SMTP_FROM="noreply@gmail.com"
MAIL_FROM_NAME="noreply"


# ─── Seed (`pnpm db:seed`, packages/db/prisma/seed/) ────────────────────────
# [TÙY CHỌN] Bỏ trống = admin@gmail.com / admin123 / 0987654321 — chỉ cho dev.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=

# [TÙY CHỌN] "false" khi seed production (chỉ tạo admin + danh mục; bắt buộc có SEED_ADMIN_PASSWORD).
SEED_DEMO_DATA=

# [TÙY CHỌN] Mật khẩu tài khoản demo staff@aodai.local / customer@aodai.local (mặc định Demo@123).
SEED_DEMO_PASSWORD=

# [TÙY CHỌN] Quên mật khẩu admin: điền rồi chạy `pnpm admin:reset:prod`
ADMIN_NEW_PASSWORD=
ADMIN_NEW_EMAIL=