# ─── Máy chủ ────────────────────────────────────────────────────────────────
PORT=3001                                   # [TÙY CHỌN] Mặc định 3001. Render tự cấp PORT — không đặt trên Render.
NODE_ENV=development                        # [TÙY CHỌN] development | production | test. production: cookie Secure (cần HTTPS), tắt Swagger.
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=1

# ─── Database ───────────────────────────────────────────────────────────────
# Neon: dùng chuỗi DIRECT (không có `-pooler`) cho API và cho lệnh migration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_aodai?schema=public"        # [BẮT BUỘC] PostgreSQL. Local: postgresql://<user>:<pass>@localhost:5432/<db>?schema=public

# ─── JWT (RS256) ────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=15m

# ─── Redis ──────────────────────────────────────────────────────────────────
# Local (Docker `docker compose up -d`): dùng HOST/PORT, để trống REDIS_URL.
# Production (Upstash): chỉ đặt REDIS_URL=rediss://default:<pass>@<host>:6379 (có URL thì bỏ qua HOST/PORT/PASSWORD).
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OTP_TTL_SECONDS=300

# ─── Google OAuth ───────────────────────────────────────────────────────────

# Thêm http://localhost:3000 vào "Authorized JavaScript origins". Giá trị giống NEXT_PUBLIC_GOOGLE_CLIENT_ID của web.
GOOGLE_CLIENT_ID=                                                                           # [BẮT BUỘC] Google Cloud → APIs & Services → Credentials → OAuth Client ID (Web application).

# ─── Cloudinary (upload ảnh) ────────────────────────────────────────────────
# [BẮT BUỘC] Cloudinary Console → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Tài khoản nhận chuyển khoản (VietQR) ───────────────────────────────────
BANK_BIN=970407
BANK_NAME=Techcombank
BANK_ACCOUNT_NUMBER=19034567891011
BANK_ACCOUNT_NAME=TIEM AO DAI THIEN CANH                                                    # BANK_ACCOUNT_NAME: viết IN HOA không dấu đúng như tên chủ tài khoản ngân hàng.

# ─── Email ──────────────────────────────────────────────────────────────────
# [TÙY CHỌN] Thứ tự ưu tiên: BREVO_API_KEY → SMTP_* → không có gì thì IN MÃ RA CONSOLE (tiện cho dev).
# Brevo: Settings → SMTP & API → tab "API keys" (dạng xkeysib-..., KHÔNG phải SMTP key). Render bắt buộc dùng Brevo (chặn cổng SMTP).
BREVO_API_KEY=
# SMTP (vd. Gmail: smtp.gmail.com / 587 / app password). Để trống cả nhóm nếu không dùng.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Email + tên người gửi (Brevo: email phải là sender đã xác minh).
SMTP_FROM="noreply@tiemthiencanh.vn"
MAIL_FROM_NAME="Thiên Canh"

# ─── Seed (`pnpm db:seed`, packages/db/prisma/seed/) ────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
SEED_DEMO_DATA=                                                                           
SEED_DEMO_PASSWORD=                                                                         
