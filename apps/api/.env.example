PORT=3001
NODE_ENV=development

# PostgreSQL database connection string for Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
JWT_PRIVATE_KEY="your_base64_private_key"
JWT_PUBLIC_KEY="your_base64_public_key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:3000"

# Số reverse proxy tin cậy đứng trước hệ thống và NỐI IP client vào X-Forwarded-For (nginx, Cloudflare...).
# Production: đặt nginx/Cloudflare trước Next.js với `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`
# Lưu ý: Next.js rewrites chuyển tiếp nguyên header nên khi chạy dev không có proxy, IP có thể bị giả mạo.
TRUST_PROXY=1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OTP_TTL_SECONDS=300

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Mail SMTP Configuration (optional, falls back to console logger if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="noreply@yourdomain.com"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
