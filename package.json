{
  "name": "learn-ecommerce-shop-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"*\" --parallel dev",
    "build": "pnpm --filter \"*\" build",
    "start": "pnpm --filter \"*\" start",
    "lint": "pnpm --filter \"*\" lint",
    "typecheck": "pnpm --filter \"*\" typecheck",
    "check": "pnpm typecheck && pnpm lint",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate:dev",
    "db:deploy": "pnpm --filter @repo/db migrate:deploy",
    "db:deploy:prod": "pnpm --filter @repo/db migrate:deploy:prod",
    "db:status:prod": "pnpm --filter @repo/db migrate:status:prod",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:seed:prod": "pnpm --filter @repo/db seed:prod",
    "db:studio": "pnpm --filter @repo/db studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "prettier": "^3.9.10",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.21.0"
}
