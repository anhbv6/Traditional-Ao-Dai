{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Base — tuỳ chọn TypeScript chung cho mọi workspace",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
