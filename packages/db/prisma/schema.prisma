generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING           // Chờ thanh toán / xác nhận
  CONFIRMED         // Đã xác nhận thông tin & số đo
  IN_PRODUCTION     // Đang trong quá trình may đo (đối với hàng Custom)
  READY_TO_SHIP     // Đã đóng gói xong
  SHIPPING          // Đang giao hàng
  DELIVERED         // Đã nhận hàng thành công
  CANCELLED         // Đã hủy
  REFUNDED          // Đã hoàn tiền
}

enum TailoringStatus {
  NOT_APPLICABLE    // Hàng may sẵn
  WAITING_FABRIC    // Chờ xuất kho vải
  FABRIC_CUTTING    // Đang cắt vải
  SEWING            // Đang may ráp
  EMBROIDERY_BEADING// Đang thêu / đính kết hoa văn
  FITTING_IRONING   // Kiểm tra form dáng & ủi phẳng
  COMPLETED         // May hoàn tất, chuyển sang đóng gói
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID    // Đặt cọc (thường áp dụng cho đơn may đo giá trị lớn)
  PAID
  REFUNDED
}

enum AppointmentType {
  MEASUREMENT       // Đến lấy số đo
  FITTING           // Đến thử áo / sửa form
  PICKUP            // Đến lấy áo
}

enum AppointmentStatus {
  SCHEDULED         // Đã hẹn
  DONE              // Khách đã đến
  CANCELLED         // Huỷ hẹn
  NO_SHOW           // Khách không đến
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE            // Đang hoạt động
  LOCKED            // Bị khóa bởi quản trị (đăng nhập bị từ chối, mọi phiên bị thu hồi)
  DELETED           // Người dùng tự xóa tài khoản — dữ liệu cá nhân đã được ẩn danh
}

// Quyền chi tiết của STAFF (ADMIN luôn có toàn quyền). Mặc định rỗng = không có quyền nào.
enum Permission {
  MANAGE_ORDERS     // Xử lý đơn hàng, tra cứu khách hàng & số đo
  UPDATE_TAILORING  // Cập nhật tiến độ xưởng may
  MANAGE_INVENTORY  // Sản phẩm, biến thể, tồn kho, kho vải
  MANAGE_CONTENT    // Bài viết, FAQ
  VIEW_REPORTS      // Doanh thu, biểu đồ thống kê
}

// Khu vực cấp phiên — token của khu này không dùng được ở khu kia (claim `aud` của JWT)
enum SessionKind {
  STORE             // Storefront: access token trong bộ nhớ + refresh token cookie
  ADMIN             // Khu quản trị: cookie admin_token, kiểm tra phiên mỗi request
}

enum AuthProvider {
  GOOGLE
}

enum ApprovalAction {
  CANCEL_ORDER
  REFUND
  MANUAL_DISCOUNT
  PRICE_OVERRIDE
}

// Nhóm hàng — quyết định cách bán: có nhập số đo không, đo những gì, bán theo cái hay theo mét
enum ProductGroup {
  AO_DAI    // May đo theo số đo đầy đủ, ghép bộ đo nhanh 3 vòng (ngực - eo - mông)
  PANTS     // May đo riêng phần quần (eo, mông, dài quần, rộng ống)
  ACCESSORY // Không nhập số đo (mấn, kiềng, túi, quạt...)
  FOOTWEAR  // Bán theo size chân (guốc mộc)
  MATERIAL  // Bán theo mét (vải)
}

enum SurchargeType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Vòng đời bộ sưu tập: nháp → sắp ra mắt (chạy quảng cáo) → mở bán → lưu trữ (chuyển vào lookbook mùa cũ)
enum CollectionStatus {
  DRAFT
  COMING_SOON
  ACTIVE
  ARCHIVED
}

// Hình thức bán: một món (may sẵn theo size), theo bộ (nhiều món bán chung một giá), may đo theo số đo
enum SaleMode {
  SINGLE
  SET
  CUSTOM
}

// Mùa mặc phù hợp của chất liệu vải
enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

// Nhóm thuộc tính dùng chung: biến thể SKU (màu, size) và đặc tính thiết kế để lọc / mô tả sản phẩm
// ==========================================
// USER & AUTHENTICATION
// ==========================================

// Một tài khoản dùng chung cho storefront và khu quản trị. STAFF/ADMIN cũng mua hàng như khách.
model User {
  id                 String       @id @default(uuid())
  email              String?      @unique // Luôn lưu chữ thường (có CHECK constraint ở migration)
  emailVerifiedAt    DateTime?
  phone              String?      @unique // Dạng 0xxxxxxxxx
  phoneVerifiedAt    DateTime?
  passwordHash       String?      // null = tài khoản chỉ đăng nhập bằng mạng xã hội
  passwordChangedAt  DateTime?
  name               String?
  avatarUrl          String?
  birthDate          DateTime?    @db.Date
  gender             Gender?
  role               Role         @default(CUSTOMER)
  permissions        Permission[] @default([]) // Chỉ có ý nghĩa với STAFF
  status             UserStatus   @default(ACTIVE)
  lockedAt           DateTime?
  lockedReason       String?
  lastLoginAt        DateTime?

  socialAccounts     SocialAccount[]
  sessions           UserSession[]
  addresses          UserAddress[]
  measurements       UserMeasurement[]
  reviews            Review[]
  orders             Order[]           @relation("CustomerOrders")
  createdOrders      Order[]           @relation("StaffCreatedOrders")
  appointments       Appointment[]     @relation("CustomerAppointments")
  assignedTasks      TailoringLog[]    @relation("TailorStaff")

  cart               Cart?
  requestedApprovals ApprovalRequest[] @relation("RequestedBy")
  reviewedApprovals  ApprovalRequest[] @relation("ReviewedBy")
  articles           Article[]         @relation("AuthorArticles")
  auditLogs          AuditLog[]        @relation("AuditActor")

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([role, status])
}

model SocialAccount {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String       // `sub` do nhà cung cấp cấp
  email          String?      // Email nhà cung cấp trả về tại thời điểm liên kết
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerUserId])
  @@unique([userId, provider]) // Mỗi tài khoản chỉ liên kết một tài khoản của mỗi nhà cung cấp
}

model UserSession {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             SessionKind
  refreshTokenHash String?     @unique @db.VarChar(64) // SHA-256 hex; null với phiên ADMIN
  familyId         String      // Họ refresh token — dùng lại token cũ thì thu hồi cả họ
  rememberMe       Boolean     @default(false)
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime    @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, kind])
  @@index([familyId])
  @@index([expiresAt])
}

model UserAddress {
  id            String   @id @default(uuid())
  receiverName  String
  receiverPhone String
  addressLine   String
  provinceCode  String?
  provinceName  String?
  districtCode  String?
  districtName  String?
  wardCode      String?
  wardName      String?
  postalCode    String?
  label         String?  // Nhà riêng, Công ty...
  isDefault     Boolean  @default(false)

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// Hồ sơ số đo may Áo Dài cá nhân
model UserMeasurement {
  id          String   @id @default(uuid())
  profileName String   // VD: "Số đo của Mai", "Số đo của Mẹ"
  isDefault   Boolean  @default(false)

  // Thông số Áo Dài chuẩn (cm / kg)
  height      Float?
  weight      Float?
  bust        Float?   // Vòng ngực
  waist       Float?   // Vòng eo
  hips        Float?   // Vòng mông
  shoulder    Float?   // Rộng vai
  armLength   Float?   // Dài tay
  armpit      Float?   // Vòng nách
  neck        Float?   // Vòng cổ
  shirtLength Float?   // Dài áo
  pantsLength Float?   // Dài quần
  thigh       Float?   // Vòng đùi (cho quần ống suông/truyền thống)
  note        String?  // Ghi chú form dáng (gù, vai xuôi...)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// CATALOG: SẢN PHẨM & BIẾN THỂ
// ==========================================
// Quy ước nội dung đa ngôn ngữ: cột gốc = tiếng Việt (bắt buộc), cột hậu tố `En` = tiếng Anh (tùy chọn).
// Chọn bản dịch bằng `pickLocalized(entity, 'name', locale)` trong @repo/shared (thiếu bản EN thì rơi về VI).

// Cây loại sản phẩm (nhóm gốc → loại con). Nút con mặc định cùng nhóm hàng với cha nhưng được đổi
// (VD guốc mộc nằm trong "Phụ kiện" nhưng bán theo size chân → FOOTWEAR)
model Category {
  id          String    @id @default(uuid())
  name        String
  nameEn      String?
  slug        String    @unique
  description String?
  descriptionEn String?
  image       String?
  group       ProductGroup @default(AO_DAI)
  position    Int       @default(0) // Thứ tự hiển thị giữa các nút cùng cha
  isActive    Boolean   @default(true)
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]@relation("CategoryHierarchy")

  // Bảng size dùng cho mọi sản phẩm thuộc loại này (sản phẩm có thể chọn bảng riêng)
  defaultSizeChartId String?
  defaultSizeChart   SizeChart? @relation(fields: [defaultSizeChartId], references: [id], onDelete: SetNull)

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId, position])
  @@index([defaultSizeChartId])
}

model Product {
  id          String           @id @default(uuid())
  code        String           @unique // Mã sản phẩm tự sinh theo nhóm hàng, VD "AD0007" — gốc của mọi SKU
  name        String
  nameEn      String?
  slug        String           @unique
  description String?          @db.Text
  descriptionEn String?        @db.Text
  saleMode    SaleMode         @default(SINGLE)
  // Theo bộ: các món trong bộ [{ label, labelEn, quantity, materialId }]
  setItems    Json             @default("[]")
  leadTimeDays Int?            // May đo: số ngày may dự kiến
  basePrice   Decimal          @db.Decimal(12, 2)
  images      String[]
  soldCount   Int              @default(0)
  isCustomFit Boolean          @default(true) // Cho phép đặt may theo số đo riêng
  isActive    Boolean          @default(true)
  isFeatured  Boolean          @default(false)

  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])

  // Bảng size riêng; null thì dùng bảng mặc định của loại sản phẩm
  sizeChartId String?
  sizeChart   SizeChart?       @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)

  // Chất liệu chính — thanh đo, bảo quản, định mức vải kế thừa từ hồ sơ chất liệu
  materialId  String?
  material    Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)

  attributes  ProductAttribute[]
  variants    ProductVariant[]
  collections CollectionProduct[]
  fabrics     Fabric[]
  reviews     Review[]
  orderItems  OrderItem[]
  cartItems   CartItem[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([sizeChartId])
  @@index([materialId])
  @@index([slug])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id        String      @id @default(uuid())
  sku       String      @unique
  size      String      // S, M, L, XL, XXL; FREE_SIZE (không có size); CUSTOM (may đo)
  color     String?     // Tên màu lúc lưu (giữ được khi thuộc tính màu bị xóa)
  colorId   String?
  colorValue AttributeValue? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  price     Decimal?    @db.Decimal(12, 2) // Null nếu dùng basePrice của Product
  stock     Int         @default(0)

  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productId])
  @@index([colorId])
  @@index([sku])
}

// Bảng size mẫu: ma trận số đo (cm/kg) cho từng size theo một form áo — dữ liệu số chứ không phải ảnh,
// để hiển thị gọn trên điện thoại, gợi ý size tự động và nhận diện đơn may đo bigsize.
// Khác "ký hiệu size" (S, M, L, 35...) — ký hiệu chỉ là nhãn của SKU, khớp với SizeChartRow.sizeLabel.
model SizeChart {
  id                    String            @id @default(uuid())
  name                  String
  nameEn                String?
  group                 ProductGroup      // Nhóm hàng áp dụng
  description           String?
  descriptionEn         String?
  measurementGuide      String?           @db.Text // Hướng dẫn tự đo: đo ngực ở đâu, eo cao hơn rốn mấy phân...
  measurementGuideEn    String?           @db.Text
  guideImage            String?           // Hình minh họa vị trí đo
  isActive              Boolean           @default(true)

  // Phụ phí khi số đo may đo vượt ngưỡng bigsize (SizeChartColumn.bigsizeFrom) ở BẤT KỲ cột nào
  bigsizeSurchargeType  SurchargeType?
  bigsizeSurchargeValue Decimal?          @db.Decimal(12, 2)
  bigsizeExtraFabric    Decimal?          @db.Decimal(6, 2) // Số mét vải tốn thêm, để xưởng chuẩn bị

  columns               SizeChartColumn[]
  rows                  SizeChartRow[]
  categories            Category[]
  products              Product[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([group, isActive])
}

// Một thông số đo của bảng size (cột) kèm ngưỡng kiểm tra số đo khách tự nhập
model SizeChartColumn {
  id          String    @id @default(uuid())
  sizeChartId String
  sizeChart   SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)
  key         String    // Mã thông số dùng chung (MEASUREMENT_KEYS ở @repo/shared/sizing): bust, waist, hips...
  position    Int       @default(0)
  validMin    Float?    // Nhỏ hơn → báo nhập sai (VD eo < 50cm)
  validMax    Float?    // Lớn hơn → báo nhập sai (VD gõ 650 thay vì 65)
  bigsizeFrom Float?    // Vượt mức này khi may đo → đơn bigsize, cộng phụ phí

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sizeChartId, key])
}

// Một size (hàng) với khoảng số đo cho từng cột: { [key]: { min, max } }
model SizeChartRow {
  id          String    @id @default(uuid())
  sizeChartId String
  sizeChart   SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)
  sizeLabel   String    // Trùng ký hiệu size của SKU: S, M, L, 35, "3-4 tuổi"...
  position    Int       @default(0)
  values      Json      // Record<key, { min: number | null, max: number | null }>

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sizeChartId, sizeLabel])
}

// Bộ sưu tập theo mùa/dịp (Tết, Thu Đông, Cưới...). Khác Category (phân loại cố định, mỗi sản phẩm một danh mục):
// một sản phẩm thuộc được nhiều bộ sưu tập. Có thể bán sản phẩm hay không vẫn do Product.isActive quyết định.
model Collection {
  id               String              @id @default(uuid())
  code             String              @unique // VD "TET26" — dùng sinh SKU, khóa lại sau khi công bố
  slug             String              @unique
  name             String
  nameEn           String?
  tagline          String?             // Một câu ngắn cho banner, quảng cáo
  taglineEn        String?
  description      String?             @db.Text
  descriptionEn    String?             @db.Text
  story            String?             @db.Text // Câu chuyện mùa — hiển thị ở lookbook
  storyEn          String?             @db.Text
  season           String?             // Nhãn mùa hiển thị, VD "Xuân 2026"
  seasonEn         String?
  coverImage       String?             // Ảnh dọc cho thẻ, lookbook
  coverImageMobile String?             // Bản cho màn nhỏ (cắt gọn hơn); trống thì dùng coverImage
  bannerImage      String?             // Ảnh ngang cho banner trang chủ / đầu trang
  bannerImageMobile String?            // Banner dọc cho mobile — ảnh ngang thu nhỏ trên điện thoại sẽ mất chủ thể
  gallery          String[]            // Ảnh lookbook
  accentColor      String?             // Màu nhấn của mùa (#RRGGBB)
  autoPushOosToBottom Boolean          @default(true) // Sản phẩm hết hàng tự xuống cuối danh sách, không chiếm vị trí đầu

  status           CollectionStatus    @default(DRAFT)
  launchAt         DateTime?           // Ngày mở bán dự kiến — bắt buộc khi "sắp ra mắt"
  endAt            DateTime?           // Ngày hết mùa dự kiến
  publishedAt      DateTime?           // Lần đầu công bố (khác null thì không xóa được, chỉ lưu trữ)
  archivedAt       DateTime?
  deletedAt        DateTime?           // Xóa mềm — mọi truy vấn lọc deletedAt = null, dữ liệu và liên kết sản phẩm vẫn giữ

  showOnHomepage   Boolean             @default(false)
  homepageOrder    Int                 @default(0)
  showInLookbook   Boolean             @default(true) // Khi lưu trữ: còn hiện ở thư viện lookbook mùa cũ

  seoTitle         String?
  seoTitleEn       String?
  seoDescription   String?
  seoDescriptionEn String?

  products         CollectionProduct[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, deletedAt])
  @@index([showOnHomepage, homepageOrder])
}

// Sản phẩm trong bộ sưu tập (nhiều - nhiều), kèm thứ tự hiển thị và sản phẩm nổi bật của mùa
model CollectionProduct {
  id            String     @id @default(uuid())
  collectionId  String
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position      Int        @default(0)
  isHighlighted Boolean    @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([collectionId, productId])
  @@index([productId])
}

// ==========================================
// GIỎ HÀNG (CART)
// ==========================================

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id          String          @id @default(uuid())
  cartId      String
  cart        Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  quantity    Int             @default(1)
  isCustomFit Boolean         @default(false)
  customData  Json?           // Lưu tạm snapshot số đo trước khi chuyển thành OrderItem

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([cartId])
}

// ==========================================
// ĐƠN HÀNG, MAY ĐO & THANH TOÁN
// ==========================================

model Voucher {
  id           String       @id @default(uuid())
  code         String       @unique
  description  String?
  discountType DiscountType @default(PERCENTAGE)
  value        Decimal      @db.Decimal(12, 2) // % giảm hoặc số tiền cố định
  minOrderValue Decimal?    @db.Decimal(12, 2)
  maxDiscount  Decimal?     @db.Decimal(12, 2)
  usageLimit   Int?
  usedCount    Int          @default(0)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean      @default(true)

  orders       Order[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique // Format: AD-YYYYMMDD-XXXX

  userId          String?
  user            User?          @relation("CustomerOrders", fields: [userId], references: [id])

  createdById     String?
  createdBy       User?          @relation("StaffCreatedOrders", fields: [createdById], references: [id])

  // Người nhận
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  note            String?

  // Tài chính
  subTotal        Decimal        @db.Decimal(12, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal        @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(12, 2) // Tiền đã thu (cọc / thanh toán) — còn nợ = totalAmount - paidAmount
  dueDate         DateTime?      // Ngày hẹn trả áo cho khách (đơn may đo thường gắn ngày sự kiện)

  voucherId       String?
  voucher         Voucher?       @relation(fields: [voucherId], references: [id])

  // Trạng thái
  orderStatus     OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(UNPAID)
  paymentMethod   String         // COD, VNPAY, MOMO, BANK_TRANSFER

  items           OrderItem[]
  tailoringLogs   TailoringLog[]
  appointments    Appointment[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([orderStatus])
  @@index([dueDate])
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String
  product       Product         @relation(fields: [productId], references: [id])

  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  // Snapshot thông tin sản phẩm tại thời điểm mua
  productName   String
  variantName   String?
  sku           String?
  quantity      Int
  unitPrice     Decimal         @db.Decimal(12, 2)
  totalPrice    Decimal         @db.Decimal(12, 2)

  // Tiến độ may đo riêng cho từng chiếc áo
  isCustomFit     Boolean         @default(false)
  tailoringStatus TailoringStatus @default(NOT_APPLICABLE)
  tailoringLogs   TailoringLog[]

  // Snapshot số đo áo dài
  height        Float?
  weight        Float?
  bust          Float?
  waist         Float?
  hips          Float?
  shoulder      Float?
  armLength     Float?
  armpit        Float?
  neck          Float?
  shirtLength   Float?
  pantsLength   Float?
  thigh         Float?
  customNote    String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderId])
  @@index([productId])
}

// Nhật ký tiến độ may đo thủ công
model TailoringLog {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String?
  orderItem   OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  status      TailoringStatus
  note        String?
  staffId     String
  staff       User            @relation("TailorStaff", fields: [staffId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([orderId])
  @@index([orderItemId])
}

// ==========================================
// ĐÁNH GIÁ (REVIEWS)
// ==========================================

model Review {
  id          String        @id @default(uuid())
  rating      Int           @default(5)
  comment     String?       @db.Text
  isApproved  Boolean       @default(true)
  media       ReviewMedia[]

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  reply       String?       @db.Text
  repliedAt   DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([productId])
  @@index([userId])
}

model ReviewMedia {
  id           String    @id @default(uuid())
  type         MediaType @default(IMAGE)
  url          String
  thumbnailUrl String?
  reviewId     String
  review       Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

// ==========================================
// PHÂN QUYỀN & PHÊ DUYỆT (STAFF & ADMIN)
// ==========================================

// STAFF gửi yêu cầu cho thao tác nhạy cảm, ADMIN duyệt rồi hệ thống tự thực thi
model ApprovalRequest {
  id            String         @id @default(uuid())
  actionType    ApprovalAction
  targetId      String?        // Id đối tượng bị tác động (vd. đơn hàng)
  description   String
  payload       Json
  status        ApprovalStatus @default(PENDING)

  requestedById String
  requestedBy   User           @relation("RequestedBy", fields: [requestedById], references: [id])

  reviewedById  String?
  reviewedBy    User?          @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  rejectReason  String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([reviewedById])
}

// Nhật ký thao tác quản trị — chỉ ghi thêm, không sửa/xóa (nên không có updatedAt)
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // Mã thao tác UPPER_SNAKE_CASE, vd. STAFF_PERMISSIONS_UPDATED
  targetType String   // USER, ORDER, APPROVAL...
  targetId   String?
  metadata   Json?    // Giá trị trước/sau, lý do...
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ==========================================
// NỘI DUNG CMS: TIN TỨC & FAQ
// ==========================================

model Article {
  id          String   @id @default(uuid())
  title       String
  titleEn     String?
  slug        String   @unique
  excerpt     String?
  excerptEn   String?
  content     String   @db.Text
  contentEn   String?  @db.Text
  thumbnail   String?
  isPublished Boolean  @default(false)

  authorId    String
  author      User     @relation("AuthorArticles", fields: [authorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  questionEn String?
  answer    String   @db.Text
  answerEn  String?  @db.Text
  category  String?  // "Hướng dẫn đo áo dài", "Vận chuyển", "Chính sách đổi trả"
  order     Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// Lịch hẹn khách đến tiệm: lấy số đo, thử áo, lấy áo
model Appointment {
  id            String            @id @default(uuid())
  customerName  String
  customerPhone String?
  type          AppointmentType
  status        AppointmentStatus @default(SCHEDULED)
  scheduledAt   DateTime
  note          String?           // VD: "Thử áo lụa hồng, sửa lại eo"

  // Khách có tài khoản → mở hồ sơ số đo (UserMeasurement)
  userId        String?
  user          User?             @relation("CustomerAppointments", fields: [userId], references: [id], onDelete: SetNull)

  // Hẹn gắn với đơn may đo → số đo snapshot trên đơn
  orderId       String?
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([scheduledAt])
  @@index([userId])
  @@index([orderId])
}

// Kho vải theo cây / cuộn (mét) — nguyên liệu may đo
model Fabric {
  id                String   @id @default(uuid())
  code              String   @unique // Mã cây vải, VD: "LUA-HONG-01"
  name              String   // VD: "Lụa tơ tằm hồng phấn"
  color             String?
  remainingMeters   Decimal  @db.Decimal(8, 2)
  lowStockThreshold Decimal  @default(3) @db.Decimal(8, 2) // Dưới ngưỡng này thì cảnh báo (≈ 1 bộ áo dài)
  isActive          Boolean  @default(true)

  // Sản phẩm may từ cây vải này — để ẩn nhanh trên web khi sắp hết vải
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Cây vải thuộc chất liệu nào — để tính tồn kho theo chất liệu và số áo còn may được
  materialId        String?
  material          Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productId])
  @@index([materialId])
  @@index([isActive, remainingMeters])
}

// Chất liệu vải (định nghĩa loại vải: lụa tơ tằm, đũi, gấm...) — khác Fabric là từng cây vải cụ thể trong kho.
// Thanh đo vật lý 1–5 chuẩn hóa để so sánh các chất liệu với nhau và tư vấn cho khách.
model Material {
  id             String   @id @default(uuid())
  code           String   @unique // VD: "LUA-TO-TAM"
  name           String
  nameEn         String?
  origin         String?  // Xuất xứ, VD: "Bảo Lộc, Lâm Đồng"
  originEn       String?
  description    String?
  descriptionEn  String?
  composition    Json     @default("[]") // Thành phần sợi: [{ fiber: "SILK", percent: 100 }]
  processSteps   Json     @default("[]") // Quy trình: [{ title, titleEn, detail, detailEn }]
  closeupImages  String[] // Ảnh chụp cận mặt vải
  videoUrl       String?  // Video chuyển động / độ rủ của vải

  // Thanh đo 1–5 (null = chưa đánh giá)
  stretch        Int?     // Độ co giãn
  thickness      Int?     // Độ dày
  drape          Int?     // Độ mềm rủ
  sheerness      Int?     // Độ xuyên thấu
  sheen          Int?     // Độ bóng bề mặt
  seasons        Season[]

  careCodes      String[] // Mã ký hiệu bảo quản (danh sách cố định ở web)
  careNote       String?
  careNoteEn     String?

  // Định mức vải
  widthCm        Int?                  // Khổ vải
  metersPerTop   Decimal? @db.Decimal(5, 2) // Mét vải cho một thân áo dài
  metersPerPants Decimal? @db.Decimal(5, 2) // Mét vải cho một quần

  isActive       Boolean  @default(true)
  position       Int      @default(0)

  fabrics        Fabric[]
  products       Product[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, position])
}

// Giá trị thuộc tính theo nhóm (màu, size, kiểu cổ...). Màu có mã hex + họ màu để lọc trên cửa hàng.
// Nhóm thuộc tính (thuộc tính cha). Nhóm hệ thống tạo bằng migration / seed và không xóa được:
// COLOR, SIZE (biến thể SKU, có hành vi riêng) và NECKLINE, SLEEVE, PATTERN_TECHNIQUE, FLAP_LENGTH, OCCASION
// (đặc tính thiết kế). Admin thêm được nhóm đặc tính thiết kế mới (VD "Chất liệu viền", "Phong cách").
model AttributeGroup {
  id            String           @id @default(uuid())
  code          String           @unique // Mã ổn định, VD "COLOR", "NECKLINE", "PHONG-CACH"
  name          String
  nameEn        String?
  description   String?
  descriptionEn String?
  isSystem      Boolean          @default(false)
  position      Int              @default(0)

  values        AttributeValue[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([position])
}

model AttributeValue {
  id            String         @id @default(uuid())
  groupId       String
  group         AttributeGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  code          String         // Mã ổn định trong nhóm, VD: "DO-DO", "S", "CO-TRU"
  name          String
  nameEn        String?
  description   String?
  descriptionEn String?
  hex           String?        // Chỉ COLOR, VD: "#8B1E3F"
  family        String?        // Chỉ COLOR: họ màu (RED, PINK...) để gom bộ lọc
  isActive      Boolean        @default(true)
  position      Int            @default(0)

  products      ProductAttribute[] // Đặc tính thiết kế gắn cho sản phẩm
  variants      ProductVariant[]   // Màu của SKU

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([groupId, code])
  @@index([groupId, position])
}

// Đặc tính thiết kế của sản phẩm (kiểu cổ, tay, họa tiết, tà, dịp) — nhiều - nhiều với AttributeValue
model ProductAttribute {
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
}
