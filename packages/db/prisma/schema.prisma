generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id                String          @id @default(uuid())
  email             String?         @unique
  password          String?
  name              String?
  phone             String?         @unique
  avatar            String?
  birth             DateTime?
  gender            Gender          @default(OTHER)
  role              Role            @default(CUSTOMER)
  isActive          Boolean         @default(true)
  isEmailVerified   Boolean         @default(false)
  isPhoneVerified   Boolean         @default(false)

  socialAccounts    SocialAccount[]

  reviews           Review[]
  measurements      UserMeasurement[]
  orders            Order[]

  sessions          UserSession[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   // "GOOGLE", "FACEBOOK", etc.
  providerId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @db.Text
  familyId     String
  isRevoked    Boolean  @default(false)
  deviceInfo   String?  // Trình duyệt / OS của thiết bị
  ipAddress    String?  // IP truy cập
  expiresAt    DateTime // Thời gian hết hạn của Refresh Token
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
  @@index([familyId])
}

model UserMeasurement {
  id          String   @id @default(uuid())
  profileName String   
  isDefault   Boolean  @default(false)

  // Các chỉ số đo may Áo Dài chuẩn (đơn vị cm)
  height      Float?   // Chiều cao
  weight      Float?   // Cân nặng
  bust        Float?   // Vòng ngực
  waist       Float?   // Vòng eo
  hips        Float?   // Vòng mông
  shoulder    Float?   // Rộng vai
  armLength   Float?   // Dài tay
  shirtLength Float?   // Dài áo
  pantsLength Float?   // Dài quần
  note        String?  // Ghi chú thêm (VD: Dáng hơi khom, vai lệch...)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String   @id @default(uuid())
  rating      Int      @default(5) // Số sao đánh giá từ 1 - 5
  comment     String?  @db.Text    // Nội dung bình luận
  media       ReviewMedia[]
  isApproved  Boolean  @default(true) // Duyệt hiển thị (để ẩn nếu có từ ngữ thô tục)

  // Liên kết với User
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Liên kết với Product
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Phản hồi từ phía Shop/Admin (nếu có)
  reply       String?  @db.Text
  repliedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReviewMedia {
  id           String    @id @default(uuid())
  type         MediaType @default(IMAGE)
  url          String    // URL gốc của ảnh/video trên Cloudinary/AWS S3
  thumbnailUrl String?   // Ảnh xem trước của video (giúp FE render nhanh hơn)

  reviewId     String
  review       Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?          @db.Text
  material    String?
  basePrice   Float            // Giá niêm yết cơ bản
  images      String[]         // Mảng chứa các URL ảnh
  reviews     Review[]
  soldCount   Int              @default(0)
  isCustomFit Boolean          @default(true) // Có cho phép nhập số đo riêng để may không
  isActive    Boolean          @default(true) // Bật/Tắt hiển thị sản phẩm

  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])

  variants    ProductVariant[]
  orderItems  OrderItem[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id        String   @id @default(uuid())
  sku       String   @unique // Mã quản lý kho (VD: AD-TRANG-S)
  size      String   // S, M, L, XL, XXL
  color     String?  // Trắng, Đỏ, Hồng, Vàng
  price     Float?   // Nhập nếu giá size này khác giá basePrice
  stock     Int      @default(0) // Số lượng tồn kho sẵn có

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // Mã đơn AD-2026-XXXX

  userId          String?
  user            User?         @relation(fields: [userId], references: [id])

  // Thông tin người nhận (Khách không cần đăng nhập vẫn mua được)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  note            String?       // Ghi chú giao hàng

  totalAmount     Float
  orderStatus     OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   String        // COD, VNPAY, MOMO, ZALOPAY

  items           OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  quantity    Int
  price       Float    // Giá tại thời điểm mua (Tránh bị đổi giá sau này)

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  // Nếu khách đặt may Áo Dài theo số đo riêng
  isCustomFit Boolean  @default(false)
  
  // Lưu snapshot số đo tại thời điểm đặt đơn (Độc lập với hồ sơ UserMeasurement)
  height      Float?
  weight      Float?
  bust        Float?
  waist       Float?
  hips        Float?
  shoulder    Float?
  armLength   Float?
  shirtLength Float?
  pantsLength Float?
  customNote  String?
}
