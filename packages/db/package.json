{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../apps/api/.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../apps/api/.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../apps/api/.env -- prisma db push",
    "studio": "dotenv -e ../../apps/api/.env -- prisma studio",
    "seed": "dotenv -e ../../apps/api/.env -- prisma db seed",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@prisma/client": "^5.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.43",
    "bcryptjs": "^3.0.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.12.0",
    "tsx": "^4.7.1",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
