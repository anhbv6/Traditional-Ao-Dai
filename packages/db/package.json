{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../apps/api/.env.local -e ../../apps/api/.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../apps/api/.env.local -e ../../apps/api/.env -- prisma migrate deploy",
    "migrate:deploy:prod": "node -e \"require('fs').accessSync('../../apps/api/.env.production')\" && dotenv -o -e ../../apps/api/.env.production -- prisma migrate deploy",
    "migrate:status:prod": "node -e \"require('fs').accessSync('../../apps/api/.env.production')\" && dotenv -o -e ../../apps/api/.env.production -- prisma migrate status",
    "db:push": "dotenv -e ../../apps/api/.env.local -e ../../apps/api/.env -- prisma db push",
    "studio": "dotenv -e ../../apps/api/.env.local -e ../../apps/api/.env -- prisma studio",
    "seed": "dotenv -e ../../apps/api/.env.local -e ../../apps/api/.env -- prisma db seed",
    "seed:prod": "node -e \"require('fs').accessSync('../../apps/api/.env.production')\" && dotenv -o -e ../../apps/api/.env.production -v SEED_DEMO_DATA=false -- prisma db seed",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p prisma",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.43",
    "bcryptjs": "^3.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "prisma": "^5.12.0",
    "tsx": "^4.7.1",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  }
}
